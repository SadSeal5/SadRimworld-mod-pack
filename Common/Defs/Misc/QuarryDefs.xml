  <WorkGiverDef>
    <defName>SadQuarry_DoBillsQuarry</defName>
    <label>mine at deep quarry</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Mining</workType>
    <priorityInType>60</priorityInType>
    <fixedBillGiverDefs>
      <li>Sad_DeepQuarry</li>
    </fixedBillGiverDefs>
    <verb>quarry at</verb>
    <gerund>quarrying at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>
