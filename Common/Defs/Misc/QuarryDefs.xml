<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Quarry Structure ThingDef -->
  <ThingDef ParentName="BuildingBase">
    <defName>Sad_DeepQuarry</defName>
    <label>deep quarry</label>
    <description>A large ground excavation pit equipped with heavy rigging and winches to extract rock chunks, metal veins, and raw components from deep subterranean strata.</description>
    <thingClass>SadSeal.MegaMod.Quarry.Building_Quarry</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.75</fillPercent>
    <designationCategory>Production</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>2800</WorkToBuild>
      <Flammability>0.2</Flammability>
    </statBases>
    <size>(5,4)</size>
    <costList>
      <Steel>60</Steel>
      <WoodLog>120</WoodLog>
    </costList>
    <researchPrerequisites>
      <li>DeepDrilling</li>
    </researchPrerequisites>
    <graphicData>
      <texPath>Things/Building/Production/Quarry/Mineshaft</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5,5)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <surfaceType>Item</surfaceType>
    <recipes>
      <li>SadQuarry_MineChunks</li>
      <li>SadQuarry_MineChunks_Marble</li>
      <li>SadQuarry_MineChunks_Granite</li>
      <li>SadQuarry_MineChunks_Slate</li>
      <li>SadQuarry_MineChunks_Limestone</li>
      <li>SadQuarry_MineChunks_Sandstone</li>
      <li>SadQuarry_MineResources</li>
      <li>SadQuarry_MineComponents</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationHotKey>Misc1</designationHotKey>
  </ThingDef>

  <!-- Quarry Recipes -->
  <RecipeDef>
    <defName>SadQuarry_MineChunks</defName>
    <label>quarry stone chunks</label>
    <description>Excavate stone chunks from the quarry floor.</description>
    <jobString>Excavating stone chunks.</jobString>
    <workAmount>2000</workAmount>
    <workSpeedStat>MiningSpeed</workSpeedStat>
    <workSkill>Mining</workSkill>
    <workerClass>SadSeal.MegaMod.Quarry.RecipeWorker_Quarry</workerClass>
    <effectWorking>Mine</effectWorking>
    <soundWorking>Recipe_Sculpting</soundWorking>
  </RecipeDef>

