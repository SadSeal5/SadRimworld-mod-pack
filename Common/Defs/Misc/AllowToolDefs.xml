<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Designations -->
  <DesignationDef>
    <defName>SadHaul_HaulUrgently</defName>
    <texturePath>UI/Designators/Haul</texturePath>
    <targetType>Thing</targetType>
  </DesignationDef>

  <DesignationDef>
    <defName>Sad_Designation_FinishOff</defName>
    <texturePath>UI/Commands/Attack</texturePath>
    <targetType>Thing</targetType>
  </DesignationDef>

  <!-- JobDef -->
  <JobDef>
    <defName>Sad_Job_FinishOff</defName>
    <driverClass>SadSeal.MegaMod.AllowTool.FinishOff.JobDriver_FinishOff</driverClass>
    <reportString>finishing off TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- WorkGiverDefs -->
  <WorkGiverDef>
    <defName>SadHaul_WorkGiver_HaulUrgently</defName>
    <label>haul urgently</label>
    <giverClass>SadSeal.MegaMod.AllowTool.HaulUrgently.WorkGiver_HaulUrgently</giverClass>
    <workType>Hauling</workType>
    <priorityInType>200</priorityInType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>Sad_WorkGiver_FinishOff</defName>
    <label>finish off downed targets</label>
    <giverClass>SadSeal.MegaMod.AllowTool.FinishOff.WorkGiver_FinishOff</giverClass>
    <workType>Hunting</workType>
    <priorityInType>150</priorityInType>
    <verb>mercy kill</verb>
    <gerund>mercy killing</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>
</Defs>
