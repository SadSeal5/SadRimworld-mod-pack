<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThinkTreeDef[defName="Humanlike" or defName="MainColonistBehaviorCore"]//li[@Class="SadSeal.MegaMod.AutoArm.JobGiver_AutoEquipBetterWeapon"]</xpath>
    <nomatch Class="PatchOperationInsert">
      <xpath>Defs/ThinkTreeDef[defName="Humanlike" or defName="MainColonistBehaviorCore"]//li[subNodes/li[@Class="JobGiver_OptimizeApparel"]]</xpath>
      <order>Append</order>
      <value>
        <li Class="SadSeal.MegaMod.AutoArm.JobGiver_AutoEquipBetterWeapon">
          <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
        </li>
      </value>
    </nomatch>
  </Operation>
</Patch>
